@page "/lobby/{gameId?}"
@using BlazorBootstrap
<div class="dark-container">
    <div class="dark-card">
        <!-- Game Status Header -->
        <div class="status-header">
            <h3 class="status-title">@(_isMine ? "Game Created" : "Game Joined")</h3>
            <div class="status-divider"></div>
        </div>

        @if (_isMine)
        {
            <div class="game-code-section">
                <p class="instruction-text">Share this code with friends:</p>
                <div class="code-copy-container">
                    <div class="code-input-container">
                        <input type="text"
                               class="code-input"
                               value="@GameId"
                               disabled/>
                    </div>
                    <button class="copy-button" @onclick="CopyToClip">
                        <MatIcon Icon="content_copy" Class="copy-icon"></MatIcon>
                    </button>
                </div>
            </div>
        }

        @if (_players?.Count > 0 && _readyPlayers is not null)
        {
            <div class="players-section">
                <h4 class="section-title">Players</h4>
                <div class="players-table">
                    @foreach (Player player in _players)
                    {
                        <div class="player-row">
                            <span class="player-name">@player.Name</span>
                            <span class="player-status">
                                @if (_readyPlayers.Contains(player.PlayerId) || IsOwner(player.PlayerId))
                                {
                                    <MatIcon Icon="check_circle" Class="ready-icon"></MatIcon>
                                }
                                else
                                {
                                    <MatIcon Icon="radio_button_unchecked" Class="pending-icon"></MatIcon>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="action-buttons">
                @if (_isMine)
                {
                    <Button Raised="true"
                               Disabled="@(_readyPlayers.Count < _players.Count)"
                               Class="action-button primary"
                               @onclick="Start">
                        Start Game
                    </Button>
                }
                else
                {
                    <Button 
                               Class="action-button primary"
                               @onclick="Start">
                        @(LocalPlayer?.PlayerId != null && _readyPlayers.Contains(LocalPlayer.PlayerId) ? "Waiting..." : "Ready")
                    </Button>   
                }
            </div>
        }
    </div>
</div>