@page "/start"
<div class="start-container">

    @if (_isPlayerSetup)
    {
        <div class="dark-container">
            <div class="dark-card">
                <div class="status-header no-margin-tb">
                    <h3 class="join-title">Player Setup</h3>
                    <div class="status-divider"></div>
                    <p class="instruction-text mt-4">Enter your name below:</p>
                </div>
                <div class="dark-input-group">
                    <input
                        type="text"
                        class="dark-code-input"
                        @bind-value="@_inputName"
                        @onkeyup="HandleKeyUp"
                        placeholder="Your name"/>
                    <button
                        disabled="@string.IsNullOrEmpty(_inputName)"
                        class="dark-button" @onclick="CreatePlayer">
                        Continue
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="welcome-screen">
            <div class="welcome-header">
                <MatH3 class="welcome-title">Welcome back, <span class="player-name">@Owner.Name</span></MatH3>
                <p class="instruction-text">What would you like to do today?</p>
            </div>

            <div class="action-buttons">
                <button Raised="true" Class="action-button" @onclick="CreateGame">
                    <span class="button-icon">
                        <MatIcon Icon="videogame_asset"></MatIcon>
                    </span>
                    <span>Create New Game</span>
                </button>

                <button Raised="true" Class="action-button" @onclick="PrepareToJoin">
                    <span class="button-icon">
                        <MatIcon Icon="group"></MatIcon>
                    </span>
                    <span>Join Existing Game</span>
                </button>

                <button Raised="true" Class="action-button secondary" @onclick="EditName">
                    <span class="button-icon">
                        <MatIcon Icon="edit"></MatIcon>
                    </span>
                    <span>Change Name</span>
                </button>
            </div>
        </div>
    }
</div>