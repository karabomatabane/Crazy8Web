@page "/"
    <!-- In your index.razor -->
<div class="game-header">
    <div class="card-icon">🃏</div>
    <h1 class="game-title">Crazy Eights</h1>
    <p class="game-tagline">The classic card game</p>
</div>

<style>
    .game-header {
        text-align: center;
        margin-bottom: 4rem;
        color: #cbccce;
    }

    .card-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        animation: float 3s ease-in-out infinite;
    }

    .game-title {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
        outline: none;
    }

    .game-tagline {
        font-size: 1.1rem;
        opacity: 0.8;
        font-weight: 300;
    }

    @@keyframes float {
         0%, 100% { transform: translateY(0); }
         50% { transform: translateY(-10px); }
     }

    @@media (max-width: 768px) {
        .game-title {
            font-size: 2rem;
        }
        .card-icon {
            font-size: 3rem;
        }
    }
</style>
<StartPage></StartPage>