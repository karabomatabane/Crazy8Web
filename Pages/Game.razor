@page "/board"
@using Crazy8.Constants
@using Crazy8Web.Utils
<div class="container">
    @if (Owner != null)
    {
        <div class="chips-container">
            <MatChipSet class="player-chips">
                @foreach (Player player in _players)
                {
                    <MatChip Label="@GetPlayerName(player)"
                             LeadingIcon="person"
                             Style="@(player == _turn ? "background-color: rgba(76, 175, 80, 0.2); border: 1px solid #4caf50; color: #e0e0e0" : "background-color: #1e293b; border: 1px solid #3a3a4a; color: #a0aec0")"
                             Class="@(player == _turn ? "active-player-chip" : "player-chip")">
                    </MatChip>
                }
            </MatChipSet>
            @if (_attacks > 0)
            {
                <div class="anim-chip">
                    <MatChipSet class="attacks-chip">
                        <MatChip Label="@GetAttacks()" LeadingIcon="bolt"
                                 Style="background-color:#2196F3;">
                        </MatChip>
                    </MatChipSet>
                </div>
            }
        </div>

        <div class="play-area">
            <div class="table-surface">
                <h3 class="table-label">Table</h3>
            </div>
            <div class="card-display desk-content hand-container">
                <img src="assets/cards/back.png"
                     class="card-image"
                     alt="Card back">
                @if (_requireSuit)
                {
                    Console.WriteLine("Required suit: " + GameService.GetRequiredSuit());
                    <img src="@Utility.GetCardImage(GameService.GetRequiredSuit()!.ToLower())"
                         class="card-image active-card"
                         alt="">
                }
                else
                {
                    <img src="@_faceUp?.Image"
                         class="card-image active-card"
                         alt="Face up card">
                }
            </div>
        </div>
        <div class="play-area round-bottom-border">
            <div class="table-surface">
                <h3 class="table-label">Your Hand</h3>
            </div>
            <div class="desk-content hand-container">
                <div class="card">
                    @for (int i = 0; i < _myCards.Length; i++)
                    {
                        Card card = _myCards[i];
                        bool isSelected = _tempChoice == i;
                        int pos = i;
                        <img src="@card?.Image" @onclick="() => SelectCard(pos)"
                             class="fan-card hand-card @(IsMyTurn() ? isSelected ? "play-card selected" : "play-card" : "no-play")" alt="@card?.Rank of @card?.Suit">
                    }
                </div>
            </div>
        </div>

        <div class="button-container">
            <Button @onclick="Pick" class="btnPi    ck action-button primary" Disabled="@(!IsMyTurn())">Draw Card</Button>
        </div>
    }
    <CustomDialog @bind-IsOpen="@_dialogIsOpen"
                  Title="Crazy 8"
                  ConfirmText="OK"
                  ShowCancel="IsMyTurn()"
                  ShowConfirm="IsMyTurn()"
                  OnConfirm="OkClick">
        @if (IsMyTurn())
        {
            <p>What suit do you want?</p>
            <select @bind="@_dialogSuit" class="suit-select">
                @foreach (string suit in Const.Suits)
                {
                    <option value="@suit">@suit</option>
                }
            </select>
        }
        else
        {
            string currentPlayer = _turn != null ? GetPlayerName(_turn) : "player";
            <MatH4>Please wait for @currentPlayer to pick a suit...</MatH4>
        }
    </CustomDialog>
    <CustomDialog @bind-IsOpen="@_gameHasEnded"
                  Title="Game Over"
                  ConfirmText="Rematch"
                  CancelText="Leave"
                  OnConfirm="Rematch"
                  OnCancel="LeaveGame">
        <div class="results-list">
            <ul>
                @for (int i = 0; i < _results.Count; i++)
                {
                Player player = _results[i];
                int rank = i + 1;
                <li class="result-item @(rank == 1 ? "highlight-first" : "")">
                    <span class="rank">@rank.</span>
                    <span class="player-name">@(player.PlayerId == Owner?.PlayerId ? "You" : player.Name)</span>
                    @if (rank == 1)
                    {
                    <span class="winner-icon">🏆</span>
                    }
                </li>
                }
            </ul>
        </div>
    </CustomDialog>
</div>