@page "/board/{gameId}"
@using BlazorBootstrap
@using Crazy8.Constants
@using Crazy8Web.Utils
<div class="container">
    @if (Owner != null)
    {
        <div class="chips-container">
            <div class="player-chips">
                @foreach (Player player in _players)
                {
                    <div @onclick="() => PenaliseForCardNumber(player.PlayerId)" class="player-chip @(player == _turn ? "active-player-chip" : "") @(player.Hand?.Length is < 4 and > 0 ? "can-click" : "")">
                        <span class="material-icons icon leading-icon">person</span>
                        <span class="player-name">@GetPlayerName(player)</span>
                        @if (player.PlayerId != Owner?.PlayerId)
                        {
                            <span class="card-count-badge">@(player.Hand?.Length ?? 0)</span>
                        }
                    </div>
                }
            </div>
            <div class="right-chips">
                @if (_myCards.Length <= 3 && Owner?.HasCalledOutThisTurn == false)
                {
                    <div class="status-chip anim-chip can-click" @onclick="AnnounceCardCount">
                        <span class="material-icons icon">volume_up</span>
                    </div>
                }

                @if (_attacks > 0)
                {
                    <div class="status-chip anim-chip">
                        <span class="material-icons icon">bolt</span>
                        <span class="label">@GetAttacks()</span>
                    </div>
                }
            </div>
        </div>

        <div class="play-area">
            <div class="table-surface">
                <h3 class="table-label">Table</h3>
            </div>
            <div class="card-display desk-content hand-container">
                <img src="assets/cards/back.png"
                     class="card-image"
                     alt="Card back">
                @if (_requireSuit && GameId != null)
                {
                    <img src="@Utility.GetCardImage(GameService.GetRequiredSuit(GameId)!.ToLower())"
                         class="card-image active-card"
                         alt="Required suit">
                }
                else
                {
                    <img src="@_faceUp?.Image"
                         class="card-image active-card"
                         alt="Face up card">
                }
            </div>
        </div>
        <div class="play-area round-bottom-border">
            <div class="table-surface">
                <h3 class="table-label">Your Hand</h3>
            </div>
            <div class="desk-content hand-container">
                <div class="card">
                    @for (int i = 0; i < _myCards.Length; i++)
                    {
                        Crazy8.Models.Card card = _myCards[i];
                        bool isSelected = _tempChoice == i;
                        int pos = i;
                        <img src="@card.Image" @onclick="() => SelectCard(pos)"
                             class="fan-card hand-card @(IsMyTurn() ? isSelected ? "play-card selected" : "play-card" : "no-play")" alt="@card.Rank of @card.Suit">
                    }
                </div>
            </div>
        </div>

        <div class="button-container">
            <Button @onclick="Pick" class="btnPick action-button primary" Disabled="@(!IsMyTurn())">Draw Card</Button>
        </div>
    }
    <CustomDialog @bind-IsOpen="@_dialogIsOpen"
                  Title="Crazy 8"
                  ConfirmText="OK"
                  ShowCancel="false"
                  ShowConfirm="IsMyTurn()"
                  Class="@(_isPeeking ? "translucent" : "")"
                  OnConfirm="OkClick">
        @if (IsMyTurn())
        {
            <p class="text-center">Which suit do you want?</p>
            <div class="peek-button-container">
                <button class="peek-button" @onclick="TogglePeek" title="Peek at your cards">
                    <MatIcon Icon="@(_isPeeking ? "visibility_off" : "visibility")"
                             Class="visibility-icon">
                    </MatIcon>
                    <span class="peek-label">@(_isPeeking ? "Hide Cards" : "Peek at Cards")</span>
                </button>
            </div>
            <div class="desk-content hand-container">
                <div class="card">
                    @foreach (string suit in Const.Suits)
                    {
                        <img src="@Utility.GetCardImage(suit.ToLower())"
                             @onclick="() => SelectRequiredSuit(suit)"
                             class="dialog-card-image @(suit == _dialogSuit ? "selected" : "")"
                             alt="Required suit">
                    }
                </div>
            </div>
        }
        else
        {
            string currentPlayer = _turn != null ? GetPlayerName(_turn) : "player";
            <MatH4>Please wait for @currentPlayer to pick a suit...</MatH4>
        }
    </CustomDialog>
    <CustomDialog @bind-IsOpen="@_gameHasEnded"
                  Title="Game Over"
                  ConfirmText="Rematch"
                  ShowConfirm="_results?.Count > 1"
                  CancelText="Leave"
                  OnConfirm="Rematch"
                  OnCancel="LeaveGame">
        <div class="results-list">
            <ul>
                @if (_results != null)
                {
                    for (int i = 0; i < _results.Count; i++)
                    {
                        Player player = _results[i];
                        int rank = i + 1;
                        <li class="result-item @(rank == 1 ? "highlight-first" : "")">
                            <span class="rank">@(rank).</span>
                            <span class="player-name">@(player.PlayerId == Owner?.PlayerId ? "You" : player.Name)</span>
                            @if (rank == 1)
                            {
                                <span class="winner-icon">🏆</span>
                            }
                        </li>
                    }
                }
            </ul>
        </div>
    </CustomDialog>
</div>