@page "/join/{playerId}"
<div class="dark-container">
    <div class="dark-card">
        <div class="status-header no-margin-tb">
            <h3 class="join-title">Join a Game</h3>
            <div class="status-divider"></div>
            <p class="instruction-text mt-4">Enter the game code below:</p>
        </div>

        <div class="dark-input-group">
            <input type="text"
                   class="dark-code-input"
                   @bind="@_joiningId"
                     @onkeyup="HandleKeyUp"
                   placeholder="Game Code"/>
            <button class="dark-button" @onclick="JoinGame">
                Join
            </button>
        </div>
    </div>
</div>